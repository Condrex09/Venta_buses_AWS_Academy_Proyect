SECRET_KEY=django-insecure-busdrex-evaluacion-2-backend-2026-super-secret-key-prod
DEBUG=True

# En AWS EC2 (Paso 4 de la guía), se recomienda '*' o tu IP elástica
ALLOWED_HOSTS=*

# ------------------------------------------------------------------------------
# Configuración de Base de Datos
# Opción 1 (Recomendada para AWS EC2 rápido sin instalar MySQL): DB_ENGINE=sqlite
# Opción 2 (Si instalaste MySQL Server en EC2 o RDS): DB_ENGINE=mysql
# ------------------------------------------------------------------------------
DB_ENGINE=sqlite
DB_NAME=busdrex_db
DB_USER=root
DB_PASSWORD=tu_contraseña_mysql_aqui
DB_HOST=127.0.0.1
DB_PORT=3306

# ------------------------------------------------------------------------------
# Credenciales del Administrador de Flota y Pasajero de Demostración (Seed)
# ------------------------------------------------------------------------------
ADMIN_USERNAME=admin_flota
ADMIN_PASSWORD=Admin1234!
PASAJERO_USERNAME=pasajero_demo
PASAJERO_PASSWORD=Pasajero1234!

# ------------------------------------------------------------------------------
# Metadatos del Estudiante (Evaluación 2 INACAP 2026)
